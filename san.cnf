[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = IN
ST = Uttar Pradesh
L = Lucknow
O = State Police CrimeNet
OU = Cyber Operations
CN = 10.50.1.249

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment

[alt_names]
IP.1 = 10.50.1.249
IP.2 = 172.20.10.2
IP.3 = 172.20.10.1
IP.4 = 127.0.0.1
DNS.1 = localhost
